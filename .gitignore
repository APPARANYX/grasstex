.DS_Store

# Generated by scripts/build_version.py at the start of a deploy. The build-v<N> git tag is the
# source of truth for the version; this file is the deployment artifact that carries it.
battle/build-version.json

# py_compile byte-cache, produced by the workflow's validation step.
__pycache__/
*.pyc

# .runtime/ is transient scratch: the private-audio checkouts, raw Sonniss GDC bundle
# pulls, fetch logs, and conversation-maintenance state all live there and are never
# committed (docs/agents/audio.md, scripts/conversation-maintenance.py).
/.runtime/

# battle_sim.php's live-sync cache on the production host (asset path -> GitHub blob
# SHA). The host writes and owns it; a committed copy would ship a stale cache.
.battle-assets-state.json

# Raw generator packs and source archives for soldiers/weapons stay local; only
# prepared models are tracked (see AGENTS.md, Asset pipeline). The weapon .zip
# sources were removed from the tree in the repo-hygiene pass; recover one from
# git history (`git checkout <sha> -- <path>`) when a re-export is needed.
Assets/soldiers/new/*.zip
Assets/weapons/*.zip
/new US models/

# Lab save password hash (placed by hand on the server; see labs/save-calibration.php)
state/lab-key.php
closeups/
decal-sheets.png

# Every audio clip (MP3 and its Opus twins, .caf and .ogg) lives in the private repo APPARANYX/grasstex-audio
# and is overlaid here by scripts/fetch_private_audio.sh in CI, the deploy and the generators. Never
# commit audio to this public repo: the licensed private weapon clips may not be redistributed. The pin
# is Assets/audio/private-audio.lock.json.
/Assets/audio/**/*.mp3
/Assets/audio/**/*.caf
/Assets/audio/**/*.ogg
