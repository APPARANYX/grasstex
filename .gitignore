.DS_Store

# Generated by scripts/build_version.py at the start of a deploy. The build-v<N> git tag is the
# source of truth for the version; this file is the deployment artifact that carries it.
battle/build-version.json

# py_compile byte-cache, produced by the workflow's validation step.
__pycache__/
*.pyc

# Raw Sonniss GDC bundle pulls (scripts/fetch_sonniss_ww2.py). Multi-hundred-megabyte
# field recordings; the committed assets are the sliced/mastered MP3s under Assets/audio.
.runtime/sonniss-ww2/
.runtime/fetch*.log
.runtime/freesound-cc0/
.runtime/garand-scan/

# Raw generator packs for soldiers/weapons stay local; only prepared models are tracked
# (see AGENTS.md, Asset pipeline). The weapon .zip sources predate this rule and remain tracked.
Assets/soldiers/new/*.zip
/new US models/

# Lab save password hash (placed by hand on the server; see labs/save-calibration.php)
state/lab-key.php
closeups/
decal-sheets.png

# Licensed small-arms clips (BOOM Library) live in the private repo APPARANYX/grasstex-audio and are
# overlaid here by scripts/fetch_weapon_audio.sh in CI and the deploy. Never commit them to this
# public repo: the licence forbids redistributing them. The pin is Assets/audio/weapon-audio.lock.json.
/Assets/audio/weapons/*/
/.runtime/weapon-audio/
